# Base URL of the news API. Leave empty to use the same origin:
# in dev the Vite server proxies /api and /ws to http://localhost:8080
# (override with API_PROXY_TARGET), and in production CloudFront routes them to the ALB.
VITE_API_URL=

# Set to "false" to never open the /ws live-updates socket. The GCP deploy builds
# with this off (Firebase Hosting can't proxy WebSockets, and the API runs without
# DATABASE_URL_DIRECT there, so there'd be nothing to receive anyway).
VITE_LIVE_UPDATES=
