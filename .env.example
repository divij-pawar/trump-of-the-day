# Base URL of the news API. Leave empty to use the same origin:
# in dev the Vite server proxies /api and /ws to http://localhost:8080
# (override with API_PROXY_TARGET); on Netlify, /api/* is proxied to API_ORIGIN
# (see netlify.toml and scripts/netlify-redirects.mjs).
VITE_API_URL=

# Full WebSocket URL for live updates, for hosts that can't proxy WebSockets.
# Production (Netlify): wss://<cloud run host>/ws. Leave empty to use the same origin.
VITE_WS_URL=

# Set to "false" to never open the live-updates socket.
VITE_LIVE_UPDATES=
